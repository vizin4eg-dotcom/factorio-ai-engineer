# LLM Configuration
OPENAI_API_KEY=your_api_key_here
OPENAI_API_BASEURL=https://openrouter.ai/api/v1
OPENAI_MODEL_NAME=deepseek/deepseek-v4.1-flash-1017

# OpenRouter provider routing order. Comma-separated (Morph,Relace) or a JSON
# array (["Morph","Relace"]). Leave empty for OpenRouter's default routing.
OPENROUTER_PROVIDER_ORDER=

# RCON API Bridge (Docker)
RCON_API_SERVER_HOST=127.0.0.1
RCON_API_SERVER_PORT=24180

# Factorio Server / Wrapper
FACTORIO_WS_HOST=127.0.0.1
FACTORIO_WS_PORT=8080
FACTORIO_RCON_PORT=27015
FACTORIO_RCON_PASSWORD=your_secure_password

# Host address the Docker RCON bridge uses to reach the game (start_all.ps1).
# Docker Desktop usually resolves host.docker.internal; some setups need a LAN IP.
FACTORIO_RCON_HOST=host.docker.internal