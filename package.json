{
  "name": "factorio-ai-engineer",
  "type": "module",
  "version": "1.0.0",
  "packageManager": "pnpm@10.30.1",
  "description": "An LLM-driven companion engineer for Factorio 2.0.",
  "author": "vizin4eg-dotcom <vizin4eg@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vizin4eg-dotcom/factorio-ai-engineer"
  },
  "keywords": [
    "factorio",
    "automation",
    "llm",
    "agent",
    "typescript"
  ],
  "scripts": {
    "dev": "pnpm dev:packages",
    "build": "pnpm build:packages",
    "build:packages": "pnpm -r --filter=./packages/* run build",
    "dev:packages": "pnpm -r --filter=./packages/* run dev",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "typecheck": "pnpm -r --filter=./packages/* run typecheck"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.7.3",
    "@antfu/ni": "^28.2.0",
    "@types/node": "24",
    "cac": "^7.1.0",
    "eslint": "^9.39.3",
    "execa": "^9.6.1",
    "lint-staged": "^16.2.7",
    "simple-git-hooks": "^2.13.1",
    "taze": "^19.9.2",
    "tsx": "^4.20.6",
    "typed-factorio": "^3.35.0",
    "typescript": "~5.9.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && pnpm typecheck"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
